---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');

// Group posts by year
const postsByYear = posts.reduce((acc, post) => {
	const year = post.data.pubDate.getFullYear();
	if (!acc[year]) {
		acc[year] = [];
	}
	acc[year].push(post);
	return acc;
}, {} as Record<number, typeof posts>);

// Sort years descending
const years = Object.keys(postsByYear)
	.map(Number)
	.sort((a, b) => b - a);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Archive | ${SITE_TITLE}`} description="Browse posts by year" />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2rem);
				margin: auto;
				padding: 1rem;
			}
			h1 {
				margin-bottom: 2rem;
			}
			.year-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.year-item {
				margin-bottom: 1rem;
			}
			.year-link {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 1rem;
				background: rgb(var(--gray-light));
				border-radius: 8px;
				text-decoration: none;
				color: rgb(var(--black));
				transition: background 0.2s;
			}
			.year-link:hover {
				background: rgb(var(--accent-light));
			}
			.year {
				font-size: 1.25rem;
				font-weight: bold;
			}
			.count {
				color: rgb(var(--gray));
				font-size: 0.875rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Archive</h1>
			<ul class="year-list">
				{
					years.map((year) => (
						<li class="year-item">
							<a href={`/archive/${year}/`} class="year-link">
								<span class="year">{year}</span>
								<span class="count">{postsByYear[year].length} post{postsByYear[year].length !== 1 ? 's' : ''}</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
