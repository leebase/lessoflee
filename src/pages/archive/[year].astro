---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');

	// Get unique years
	const years = [...new Set(posts.map((post) => post.data.pubDate.getFullYear()))];

	return years.map((year) => ({
		params: { year: String(year) },
		props: {
			year,
			posts: posts
				.filter((post) => post.data.pubDate.getFullYear() === year)
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

interface Props {
	year: number;
	posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
}

const { year, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${year} Archive | ${SITE_TITLE}`} description={`All posts from ${year}`} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2rem);
				margin: auto;
				padding: 1rem;
			}
			.header {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-bottom: 2rem;
			}
			.back-link {
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.back-link:hover {
				color: rgb(var(--accent));
			}
			h1 {
				margin: 0;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-item {
				margin-bottom: 1.5rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.post-item:last-child {
				border-bottom: none;
			}
			.post-link {
				text-decoration: none;
				color: rgb(var(--black));
			}
			.post-link:hover .post-title {
				color: rgb(var(--accent));
			}
			.post-title {
				font-size: 1.25rem;
				margin: 0 0 0.5rem 0;
				transition: color 0.2s;
			}
			.post-date {
				color: rgb(var(--gray));
				font-size: 0.875rem;
				margin: 0;
			}
			.post-description {
				color: rgb(var(--gray-dark));
				margin: 0.5rem 0 0 0;
				font-size: 0.9375rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="header">
				<a href="/archive/" class="back-link">&larr; All Years</a>
				<h1>{year}</h1>
			</div>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li class="post-item">
							<a href={`/blog/${post.id}/`} class="post-link">
								<h2 class="post-title">{post.data.title}</h2>
								<p class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								{post.data.description && <p class="post-description">{post.data.description}</p>}
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
